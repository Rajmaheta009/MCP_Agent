PROJECT_NAME=Raj Assistant MCP
VERSION=1.0.0

# Weather (Open-Meteo needs no API key)
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast

# NewsData.io - create your own key
NEWS_API_KEY=pub_e1735407eb5642b29acd4931e2f2cf52
NEWS_BASE_URL=https://newsdata.io/api/1/latest

# Gemini - create your own key
GEMINI_API_KEY=e5362baf-c777-4d57-a609-6eaf1f9e87f6
GEMINI_MODEL=gemini-2.5-flash

# Currency - Frankfurter is public and keyless
CURRENCY_BASE_URL=https://api.frankfurter.app

# Local RAG
RAG_PERSIST_DIR=./data/chroma
RAG_COLLECTION=raj_assistant_documents
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

HTTP_TIMEOUT=20
LOG_LEVEL=INFO
